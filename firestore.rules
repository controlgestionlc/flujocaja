rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Colecciones de Flujo de Caja Consolidado (prefijo fc_). Solo usuarios autenticados.
    // Para restringir a correos específicos, reemplaza la condición por:
    //   request.auth != null && request.auth.token.email in ['tu@correo.cl', 'otro@correo.cl']
    match /{col}/{doc} {
      allow read, write: if col.matches('fc_.*') && request.auth != null;
    }
  }
}
